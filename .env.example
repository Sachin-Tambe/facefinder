# Database: Neon (production) — paste the POOLED connection string from Neon console
# (Connect -> Connection pooling ON; host contains "-pooler"). Keep ?sslmode=require as provided.
NEON_DATABASE_URL=
# Offline/local fallback only: used when NEON_DATABASE_URL is empty. Needs `docker compose up -d postgres`.
DATABASE_URL=postgres://facefinder:facefinder@localhost:5433/facefinder?sslmode=disable
BETTER_AUTH_SECRET=change-me-32-byte-minimum-secret
BETTER_AUTH_URL=http://localhost:3000
API_ADDR=:8080
PUBLIC_API_URL=http://localhost:8080
PUBLIC_WEB_URL=http://localhost:3000
# Redis: Upstash (production) — paste the TCP connection URL from Upstash console
# (Database -> Connect -> "Redis" / rediss:// URL). MUST start with rediss:// (TLS).
# Asynq uses the Redis protocol, NOT the Upstash REST API (UPSTASH_REDIS_REST_* won't work here).
UPSTASH_REDIS_URL=
# Offline/local fallback only: used when UPSTASH_REDIS_URL is empty. Needs `docker compose up -d redis`.
REDIS_URL=redis://localhost:6379/0
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=facefinder-private
R2_ENDPOINT=
WHATSAPP_GATEWAY_BASE_URL=
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_WEBHOOK_SECRET=change-me
WHATSAPP_BUSINESS_NUMBER=919999999999
WHATSAPP_SESSION_TTL_HOURS=24
SELFIE_RETENTION_MINUTES=60
DEFAULT_FACE_RETENTION_DAYS=30
DEFAULT_PHOTO_RETENTION_DAYS=180
DEFAULT_GALLERY_TTL_HOURS=24
FACE_MATCH_THRESHOLD_STRONG=95
FACE_MATCH_THRESHOLD_POSSIBLE=85
SEARCH_FACE_THRESHOLD=80
