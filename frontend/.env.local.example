# Neon Auth (from Neon Console -> your project -> Auth / Better Auth -> enable, then copy the Auth URL)
# Leave NEON_AUTH_BASE_URL empty to use the built-in Go auth instead.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=generate-a-random-secret-at-least-32-characters
# Must match BETTER_AUTH_SECRET in the project-root .env (used only by this server, never sent to the browser)
BETTER_AUTH_SECRET=change-me-32-byte-minimum-secret
NEXT_PUBLIC_NEON_AUTH_ENABLED=false
NEXT_PUBLIC_API_URL=http://localhost:8080
